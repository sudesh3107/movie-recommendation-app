erDiagram
    USERS ||--o{ WATCHLIST : "has"
    USERS ||--o{ REVIEWS : "writes"
    USERS ||--o{ WATCH_HISTORY : "watches"
    GENRES ||--o{ MOVIES : "categorizes"
    MOVIES ||--o{ WATCHLIST : "added_to"
    MOVIES ||--o{ REVIEWS : "reviewed_in"
    MOVIES ||--o{ WATCH_HISTORY : "watched_in"

    USERS {
        int id PK
        varchar fullname
        varchar email UK
        varchar password
        timestamp created_at
    }

    GENRES {
        int id PK
        varchar genre_name UK
    }

    MOVIES {
        int id PK
        varchar title
        text description
        int genre_id FK
        year release_year
        int duration
        decimal rating
        varchar poster_url
        varchar trailer_url
        timestamp created_at
    }

    WATCHLIST {
        int id PK
        int user_id FK
        varchar movie_id
        varchar movie_title
        varchar poster
        timestamp created_at
    }

    REVIEWS {
        int user_id FK
        varchar movie_id FK
        varchar movie_title
        decimal rating
        text review
        timestamp created_at
        PK(user_id, movie_id)
    }

    WATCH_HISTORY {
        int user_id FK
        varchar movie_id FK
        varchar title
        varchar poster
        timestamp watched_at
        PK(user_id, movie_id)
    }