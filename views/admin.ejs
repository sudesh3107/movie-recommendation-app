<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | MovieFlix</title>

    <link rel="stylesheet" href="/css/admin.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
</head>
<body>

<div class="sidebar">

    <h2>🎬 MovieFlix</h2>

    <ul>
        <li><a href="#"><i class="fa-solid fa-chart-line"></i> Dashboard</a></li>
        <li><a href="#"><i class="fa-solid fa-film"></i> Movies</a></li>
        <li><a href="#"><i class="fa-solid fa-users"></i> Users</a></li>
        <li><a href="#"><i class="fa-solid fa-star"></i> Reviews</a></li>
        <li><a href="#"><i class="fa-solid fa-heart"></i> Watchlists</a></li>
        <li><a href="/"><i class="fa-solid fa-house"></i> Back to Website</a></li>
    </ul>

</div>

<div class="main">

    <h1>Admin Dashboard</h1>

    <div class="cards">

        <div class="card">
            <h2>Total Movies</h2>
            <h1>120</h1>
        </div>

        <div class="card">
            <h2>Total Users</h2>
            <h1>45</h1>
        </div>

        <div class="card">
            <h2>Total Reviews</h2>
            <h1>86</h1>
        </div>

        <div class="card">
            <h2>Watchlists</h2>
            <h1>72</h1>
        </div>

    </div>

    <h2>Add New Movie</h2>

    <form>

        <input type="text" placeholder="Movie Title">

        <input type="text" placeholder="Genre">

        <input type="number" placeholder="Release Year">

        <input type="text" placeholder="Poster URL">

        <textarea placeholder="Movie Description"></textarea>

        <button>Add Movie</button>

    </form>

</div>

</body>
</html>