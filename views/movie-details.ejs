<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title><%= movie.title %> | MovieFlix</title>

<link rel="stylesheet" href="/css/style.css">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<link rel="stylesheet" href="/css/professional.css">
</head>

<body>

<nav class="navbar">

<div class="logo">
<i class="fa-solid fa-film"></i>
<h2>MovieFlix</h2>
</div>

<ul class="nav-links">

<li><a href="/">Home</a></li>

<% if(user){ %>
<li><a href="/watchlist">Watchlist</a></li>
<li><a href="/profile">Profile</a></li>
<li><a href="/api/auth/logout">Logout</a></li>
<% }else{ %>
<li><a href="/login">Login</a></li>
<% } %>

</ul>

</nav>

<section class="details-hero">

<div class="details-poster-wrap">

<img
src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>"
class="details-poster">

</div>

<div class="details-content">

<h1 class="details-title">
<%= movie.title %>
</h1>

<div class="details-meta">

    <span><strong>Rating</strong> <%= movie.vote_average %> / 10</span>

    <span><strong>Release</strong> <%= movie.release_date %></span>

    <span>
        <strong>Genres</strong>
        <% movie.genres.forEach(function(g,index){ %>
            <%= g.name %><%= index < movie.genres.length-1 ? "," : "" %>
        <% }) %>
    </span>

    <span><strong>Runtime</strong> <%= movie.runtime %> minutes</span>

    <span><strong>Language</strong> <%= movie.original_language.toUpperCase() %></span>

</div>

<h2>Story</h2>

<p class="overview">
<%= movie.overview %>
</p>

<br>

<div class="details-actions">

    <% if(movie){ %>

        <a href="/movie/<%= movie.id %>/watch" class="btn-primary">
            <i class="fa-solid fa-play"></i>
            Watch movie
        </a>

    <% } %>

    <form action="/watchlist/add" method="POST">
        <input type="hidden" name="movie_id" value="<%= movie.id %>">
        <input type="hidden" name="movie_title" value="<%= movie.title %>">
        <input type="hidden" name="poster" value="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>">
        <button class="watch-btn" type="submit">
            <i class="fa-solid fa-bookmark"></i>
            Add to watchlist
        </button>
    </form>

    <a href="/" class="btn-secondary">
        <i class="fa-solid fa-arrow-left"></i>
        Back home
    </a>

</div>

</div>

</section>

<section class="similar-section">

<h2 class="section-title">

🎬 Similar Movies

</h2>

<div class="movie-row">

<% similarMovies.forEach(movie=>{ %>

<div class="movie-card">

<img
src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>">

<div class="movie-info">

<h3><%= movie.title %></h3>

<p>⭐ <%= movie.vote_average %></p>

<a
href="/movie/<%= movie.id %>"
class="details-btn">

View Details

</a>

</div>

</div>

<% }) %>

</div>

</section>

<section class="reviews-section">

<h2 class="section-title">
⭐ Reviews
</h2>

<% if(user){ %>

<button type="button" class="btn-secondary" id="toggleReview" style="padding:8px 18px;font-size:13px;margin-bottom:12px;">
    <i class="fa-solid fa-pen"></i>
    Write a Review
</button>

<div id="reviewFormWrap" style="display:none;">

<form action="/reviews/add" method="POST" class="review-form">

<input type="hidden" name="movie_id" value="<%= movie.id %>">

<input type="hidden" name="movie_title" value="<%= movie.title %>">

<label style="display:block;margin-bottom:6px;font-weight:600;">
    Rating
</label>

<div class="star-rating">

    <i class="fa-regular fa-star star" data-value="1"></i>
    <i class="fa-regular fa-star star" data-value="2"></i>
    <i class="fa-regular fa-star star" data-value="3"></i>
    <i class="fa-regular fa-star star" data-value="4"></i>
    <i class="fa-regular fa-star star" data-value="5"></i>

</div>

<input
type="hidden"
name="rating"
id="rating"
required>

<label style="display:block;margin:8px 0 6px;font-weight:600;">
    Your Review
</label>

<textarea
name="review"
rows="2"
required
style="width:100%;padding:8px 12px;border-radius:8px;resize:none;font-size:13px;"></textarea>

<button class="btn-primary" type="submit" style="margin-top:8px;padding:8px 18px;font-size:13px;">
    <i class="fa-solid fa-paper-plane"></i>
    Submit Review
</button>

</form>

</div>

<% } %>

<% if(reviews.length > 0){ %>

    <% reviews.forEach(review => { %>

       <div class="review-card">

    <div class="review-top">

        <div class="review-user">

            <i class="fa-solid fa-circle-user"></i>
            <div>
                <h4><%= review.fullname %></h4>

                <span>
                    <%= new Date(review.created_at).toLocaleDateString("en-IN",{
                        day:"2-digit",
                        month:"short",
                        year:"numeric"
                    }) %>
                </span>
            </div>

        </div>

        <div class="review-stars">
            <% for(let i=1;i<=5;i++){ %>

                <% if(i<=review.rating){ %>
                    <i class="fa-solid fa-star"></i>
                <% }else{ %>
                    <i class="fa-regular fa-star"></i>
                <% } %>

            <% } %>
        </div>

    </div>

    <div class="review-content">
        <%= review.review %>
    </div>

</div>
    <% }) %>

<% } else { %>

    <p>No reviews yet.</p>

<% } %>

</section>

<footer>

    <h2>MovieFlix</h2>

    <p>Powered by TMDb</p>

</footer>

<script>

const toggleReview = document.getElementById("toggleReview");
const reviewFormWrap = document.getElementById("reviewFormWrap");

if (toggleReview && reviewFormWrap) {
    toggleReview.addEventListener("click", () => {
        const hidden = reviewFormWrap.style.display === "none";
        reviewFormWrap.style.display = hidden ? "block" : "none";
        toggleReview.innerHTML = hidden
            ? '<i class="fa-solid fa-xmark"></i> Close Review Form'
            : '<i class="fa-solid fa-pen"></i> Write a Review';
    });
}

const stars = document.querySelectorAll(".star");
const ratingInput = document.getElementById("rating");

stars.forEach(star => {

    star.addEventListener("click", () => {

        const value = star.dataset.value;

        ratingInput.value = value;

        stars.forEach(s => {

            if (Number(s.dataset.value) <= Number(value)) {

                s.classList.remove("fa-regular");
                s.classList.add("fa-solid");
                s.classList.add("active");

            } else {

                s.classList.remove("fa-solid");
                s.classList.add("fa-regular");
                s.classList.remove("active");

            }

        });

    });

});

</script>

<script src="/js/effects.js"></script>

</body>
</html>