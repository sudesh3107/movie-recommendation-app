<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MovieFlix | Profile</title>

    <link rel="stylesheet" href="/css/profile.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
<link rel="stylesheet" href="/css/effects.css">
</head>
<body>

<!-- =========================
        NAVBAR
========================== -->

<nav class="navbar">

    <div class="logo">
        <i class="fa-solid fa-film"></i>
        MovieFlix
    </div>

    <ul>

        <li><a href="/">Home</a></li>

        <li><a href="/watchlist">Watchlist</a></li>

        <li><a href="/profile" class="active">Profile</a></li>

        <li><a href="/api/auth/logout">Logout</a></li>

    </ul>

</nav>

<!-- =========================
      PROFILE HEADER
========================== -->

<section class="profile-header">

    <div class="profile-left">

        <img
            src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.fullname) %>&background=e50914&color=fff&size=250"
            alt="Profile"
            class="profile-img">

    </div>

    <div class="profile-center">

        <h1><%= user.fullname %></h1>

        <p>
            <i class="fa-solid fa-envelope"></i>
            <%= user.email %>
        </p>

        <span class="member-badge">
            <i class="fa-solid fa-circle-check"></i>
            Premium MovieFlix Member
        </span>

    </div>

    <div class="profile-right">

        <a href="/profile/edit" class="edit-btn">
            <i class="fa-solid fa-user-pen"></i>
            Edit Profile
        </a>

        <a href="/watchlist" class="watchlist-btn">
            <i class="fa-solid fa-bookmark"></i>
            My Watchlist
        </a>

    </div>

</section>

<!-- =========================
      QUICK STATS
========================== -->

<section class="stats-section">

    <div class="stat-card">

        <i class="fa-solid fa-bookmark"></i>

        <h2><%= watchlistCount %></h2>

        <p>Watchlist</p>

    </div>

    <div class="stat-card">

        <i class="fa-solid fa-clock-rotate-left"></i>

        <h2>0</h2>

        <p>History</p>

    </div>

    <div class="stat-card">

        <i class="fa-solid fa-star"></i>

        <h2>0</h2>

        <p>Reviews</p>

    </div>

    <div class="stat-card">

        <i class="fa-solid fa-heart"></i>

        <h2>0</h2>

        <p>Favorites</p>

    </div>

</section>

<!-- =========================
      PART 2 STARTS HERE
========================== -->
<!-- ===========================================
            FAVORITE GENRES
=========================================== -->

<section class="dashboard-section">

    <div class="section-header">

        <h2>

            <i class="fa-solid fa-masks-theater"></i>

            Favorite Genres

        </h2>

    </div>

    <div class="genre-container">

        <span class="genre">Action</span>

        <span class="genre">Sci-Fi</span>

        <span class="genre">Adventure</span>

        <span class="genre">Thriller</span>

        <span class="genre">Comedy</span>

        <span class="genre">Drama</span>

        <span class="genre">Fantasy</span>

        <span class="genre">Animation</span>

    </div>

</section>

<!-- ===========================================
            PART 3 STARTS HERE
=========================================== -->
<!-- ===========================================
            YOUR REVIEWS
=========================================== -->

<section class="dashboard-section">

    <div class="section-header">

        <h2>
            <i class="fa-solid fa-star"></i>
            Your Recent Reviews
        </h2>

        <a href="#">View All</a>

    </div>

    <div class="review-list">

        <div class="review-item">

            <div class="review-header">

                <h3>Interstellar</h3>

                <div class="review-stars">
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                </div>

            </div>

            <p>
                One of the best science-fiction movies ever made.
                Amazing visuals, music and storytelling.
            </p>

        </div>

        <div class="review-item">

            <div class="review-header">

                <h3>Avengers: Endgame</h3>

                <div class="review-stars">
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-regular fa-star"></i>
                </div>

            </div>

            <p>
                Fantastic ending to the Infinity Saga with emotional moments.
            </p>

        </div>

    </div>

</section>

<!-- ===========================================
            PART 4 STARTS HERE
=========================================== -->
<!-- ===========================================
            RECOMMENDED FOR YOU
=========================================== -->

<!-- ===========================================
            ACCOUNT SUMMARY
=========================================== -->

<section class="dashboard-section">

    <div class="section-header">

        <h2>
            <i class="fa-solid fa-chart-simple"></i>
            Account Summary
        </h2>

    </div>

    <div class="summary-grid">

        <div class="summary-card">

            <i class="fa-solid fa-bookmark"></i>

            <h3>Watchlist</h3>

            <p><%= watchlistCount %> Movies Saved</p>

        </div>

        <div class="summary-card">

            <i class="fa-solid fa-star"></i>

            <h3>Reviews</h3>

            <p>0 Reviews</p>

        </div>

        <div class="summary-card">

            <i class="fa-solid fa-clock"></i>

            <h3>History</h3>

            <p>0 Movies Viewed</p>

        </div>

        <div class="summary-card">

            <i class="fa-solid fa-user-check"></i>

            <h3>Status</h3>

            <p>Active Member</p>

        </div>

    </div>

</section>

<!-- ===========================================
                FOOTER
=========================================== -->

<footer class="profile-footer">

    <p>
        © 2026 MovieFlix • Built with ❤️ using Node.js, Express, MySQL & TMDb API
    </p>

</footer>

<script src="/js/effects.js"></script>

</body>
</html>