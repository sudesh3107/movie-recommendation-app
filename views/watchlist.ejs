<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Watchlist | MovieFlix</title>

<link rel="stylesheet" href="/css/style.css">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<link rel="stylesheet" href="/css/professional.css">
</head>

<body>

<nav class="navbar">

<div class="logo">
<i class="fa-solid fa-film"></i>
<h2>MovieFlix</h2>
</div>

<ul class="nav-links">
<li><a href="/">Home</a></li>
<li><a href="/watchlist">Watchlist</a></li>
<li><a href="/profile">Profile</a></li>
</ul>

</nav>

<main class="watchlist-page">

<div class="watchlist-header">
<h1>My Watchlist</h1>
<p class="watchlist-count">Total movies: <strong><%= movies.length %></strong></p>
</div>

<% if(movies.length>0){ %>

<div class="watchlist-container">

<% movies.forEach(movie=>{ %>

<div class="watch-card">

<img class="watch-poster"
src="<%= movie.poster %>"
alt="<%= movie.movie_title %>">

<div class="watch-info">
<h2><%= movie.movie_title %></h2>

<p>
<i class="fa-solid fa-heart"></i>
Saved in Watchlist
</p>

<div class="watchlist-actions">

<a href="/movie/<%= movie.movie_id %>" class="details-btn">
<i class="fa-solid fa-circle-info"></i>
Details
</a>

<a href="/watchlist/remove/<%= movie.id %>"
class="remove-btn">
<i class="fa-solid fa-trash"></i>
Remove
</a>

</div>

</div>

</div>

<% }) %>

</div>

<% } else { %>

<div class="empty">

<i class="fa-solid fa-heart-crack"></i>

<h2>
Your Watchlist is Empty
</h2>

<p>
Start adding your favourite movies.
</p>

<br>

<a href="/" class="btn-primary">

<i class="fa-solid fa-film"></i>

Explore Movies

</a>

</div>

<% } %>

</main>

<footer>

<h2>MovieFlix</h2>

<p>Powered by TMDb</p>

</footer>

<script src="/js/effects.js"></script>

</body>

</html>