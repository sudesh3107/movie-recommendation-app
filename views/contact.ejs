<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact | MovieFlix</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/css/contact.css">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

<link rel="stylesheet" href="/css/professional.css">
</head>
<body>

<nav class="navbar">

<div class="logo">🎬 MovieFlix</div>

<ul class="nav-links">
<li><a href="/">Home</a></li>
<li><a href="/movies">Movies</a></li>
<li><a href="/watchlist">Watchlist</a></li>
<li><a href="/contact" class="active">Contact</a></li>
</ul>

</nav>

<section class="contact">

<h1>Contact Us</h1>

<p>Have questions or suggestions? We'd love to hear from you.</p>

<form>

<input type="text" placeholder="Full Name" required>

<input type="email" placeholder="Email Address" required>

<input type="text" placeholder="Subject">

<textarea rows="6" placeholder="Write your message..." required></textarea>

<button type="submit">Send Message</button>

</form>

</section>

<section class="contact-info">

<div class="box">
<i class="fa-solid fa-envelope"></i>
<h3>Email</h3>
<p>support@movieflix.com</p>
</div>

<div class="box">
<i class="fa-solid fa-phone"></i>
<h3>Phone</h3>
<p>+91 9876543210</p>
</div>

<div class="box">
<i class="fa-solid fa-location-dot"></i>
<h3>Address</h3>
<p>Sangli, Maharashtra</p>
</div>

</section>

<footer>

<p>© 2026 MovieFlix | All Rights Reserved</p>

</footer>

<script src="/js/effects.js"></script>

</body>
</html>