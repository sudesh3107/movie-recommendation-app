    </div>

</section>

<!-- ================= FOOTER ================= -->

<footer>

    <div class="footer-content">

        <h2>🎬 MovieFlix</h2>

        <p>
            Your Ultimate Movie Recommendation Platform
        </p>

        <p>
            Built with ❤️ using Node.js, Express, MySQL & TMDb API
        </p>

        <div class="footer-links">

            <a href="/">Home</a>

            <a href="#trending">Trending</a>

            <a href="#toprated">Top Rated</a>

            <a href="#nowplaying">Now Playing</a>

            <a href="#indian">Indian Movies</a>

        </div>

        <div class="social-icons">

            <a href="#"><i class="fab fa-facebook-f"></i></a>

            <a href="#"><i class="fab fa-instagram"></i></a>

            <a href="#"><i class="fab fa-x-twitter"></i></a>

            <a href="#"><i class="fab fa-youtube"></i></a>

        </div>

        <hr>

        <p class="copyright">
            © 2026 MovieFlix. All Rights Reserved.
        </p>

    </div>

</footer>

<div class="trailer-modal" id="trailerModal" hidden>

    <div class="trailer-modal-backdrop" data-trailer-close></div>

    <div class="trailer-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="trailerModalTitle">

        <div class="trailer-modal-head">

            <div class="trailer-modal-copy">

                <p class="trailer-modal-kicker">Trailer</p>

                <h2 id="trailerModalTitle">Official trailer</h2>

            </div>

            <button type="button" class="trailer-modal-close" data-trailer-close aria-label="Close trailer">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>

        <div class="trailer-modal-stage">

            <p class="trailer-modal-loading" id="trailerLoading">Loading trailer...</p>

            <p class="trailer-modal-error" id="trailerError" hidden>Trailer is unavailable for this movie.</p>

            <iframe
                id="trailerFrame"
                title="Movie trailer"
                src="about:blank"
                hidden
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                playsinline
                referrerpolicy="strict-origin-when-cross-origin">
            </iframe>

        </div>

    </div>

</div>

<!-- ================= JAVASCRIPT ================= -->

<script>

const menuToggle = document.querySelector(".menu-toggle");
const navLinks = document.querySelector(".nav-links");

menuToggle.addEventListener("click", () => {
    navLinks.classList.toggle("active");
});

// Close mobile menu after clicking a link

document.querySelectorAll(".nav-links a").forEach(link => {

    link.addEventListener("click", () => {

        navLinks.classList.remove("active");

    });

});

</script>
<script>
window.addEventListener("pageshow", () => {
    const searchInput = document.querySelector('input[name="search"]');
    if (searchInput) {
        searchInput.value = "";
    }
});
</script>

<script src="/js/redesign.js"></script>
<script src="/js/effects.js"></script>
<script src="/js/trailer.js"></script>

</body>

</html>