<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MovieFlix</title>

    <link rel="stylesheet" href="/css/style.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <link rel="stylesheet" href="/css/professional.css">
</head>

<body>

<!-- ================= NAVBAR ================= -->

<nav class="navbar" id="navbar">

    <div class="logo">
        <i class="fa-solid fa-film"></i>
        <h2>MovieFlix</h2>
    </div>

    <div class="menu-toggle">
        <i class="fas fa-bars"></i>
    </div>

    <ul class="nav-links">

        <li><a href="/">Home</a></li>
        <li><a href="#trending">Trending</a></li>
        <li><a href="#toprated">Top Rated</a></li>
        <li><a href="#indian">Indian</a></li>
        <li><a href="#nowplaying">Now Playing</a></li>

        <% if(user){ %>

            <li><a href="/watchlist">Watchlist</a></li>
            <li><a href="/profile">Profile</a></li>
            <li><a href="/api/auth/logout">Logout</a></li>

        <% } else { %>

            <li><a href="/login">Login</a></li>
            <li><a href="/register">Register</a></li>

        <% } %>

    </ul>

</nav>

<!-- ================= HERO ================= -->

<section class="home-hero" id="hero">

    <!-- Dynamic backdrop slides from real trending movies -->
    <div class="hero-slides">

        <% if(trending.length){ %>

            <% trending.slice(0,5).forEach((movie, i) => { %>

                <div class="hero-slide <%= i === 0 ? 'active' : '' %>"
                     style="background-image:url('https://image.tmdb.org/t/p/original<%= movie.backdrop_path %>')">
                    <div class="hero-slide-shade"></div>
                </div>

            <% }) %>

        <% } %>

    </div>

    <div class="hero-overlay">

        <div class="hero-content">

            <span class="tagline">
                🎬 MovieFlix Originals
            </span>

            <h1>
                Unlimited Movies,<br>
                TV Shows & More.
            </h1>

            <p>
                Discover Trending, Bollywood, Hollywood and thousands of
                movies powered by TMDb.
            </p>

            <form action="/" method="GET" class="search-box">

                <input
                    type="text"
                    name="search"
                    placeholder="Search by title, genre, or mood..."
                    value="<%= search %>">

                <button type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Search library
                </button>

            </form>

            <div class="hero-buttons">

                <a href="#trending" class="btn-primary">
                    <i class="fa-solid fa-compass"></i>
                    Explore library
                </a>

                <% if(user){ %>

                    <a href="/watchlist" class="btn-secondary">
                        <i class="fa-solid fa-bookmark"></i>
                        My Watchlist
                    </a>

                <% } else { %>

                    <a href="/register" class="btn-secondary">
                        <i class="fa-solid fa-user-plus"></i>
                        Join Now
                    </a>

                <% } %>

            </div>

        </div>

    </div>

    <% if(trending.length){ %><div class="hero-dots" id="heroDots"></div><% } %>

</section>

<!-- ================= SEARCH RESULTS ================= -->

<% if(search){ %>

<section id="movies" class="reveal">

    <h2 class="section-title">
        🔍 Search Results
    </h2>

    <div class="movie-row">

        <% if(movies.length > 0){ %>

            <% movies.forEach(movie => { %>

            <div class="movie-card" data-href="/movie/<%= movie.id %>">

                <span class="card-rating">★ <%= movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A' %></span>

                <img
                    src="<%= movie.poster_path ? 'https://image.tmdb.org/t/p/w500' + movie.poster_path : '/images/no-poster.png' %>"
                    alt="<%= movie.title %>">

                <div class="movie-info">

                    <h3><%= movie.title %></h3>

                    <p>📅 <%= movie.release_date || 'N/A' %></p>

                    <div class="buttons">

                        <button type="button" class="details-btn trailer-trigger" data-movie-id="<%= movie.id %>" data-movie-title="<%= movie.title %>">
                            <i class="fa-solid fa-play"></i>
                            Watch Trailer
                        </button>

                        <form action="/watchlist/add" method="POST">

                            <input type="hidden" name="movie_id" value="<%= movie.id %>">

                            <input type="hidden" name="movie_title" value="<%= movie.title %>">

                            <input type="hidden"
                                   name="poster"
                                   value="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>">

                            <button class="watch-btn">
                                <i class="fa-solid fa-bookmark"></i>
                                Watchlist
                            </button>

                        </form>

                    </div>

                </div>

            </div>

            <% }) %>

        <% } else { %>

            <p class="empty-note">No movies found. Try another search.</p>

        <% } %>

    </div>

</section>

<% } %>

<!-- ================= TRENDING ================= -->

<section id="trending" class="reveal">

    <h2 class="section-title">
        🔥 Trending Movies
    </h2>

    <div class="row-wrapper">

        <button class="row-arrow left" aria-label="Scroll left"><i class="fa-solid fa-chevron-left"></i></button>

        <div class="movie-row">

            <% trending.forEach(movie => { %>

            <div class="movie-card" data-href="/movie/<%= movie.id %>">

                <span class="card-rating">★ <%= movie.vote_average.toFixed(1) %></span>

                <img
                    src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>"
                    alt="<%= movie.title %>">

                <div class="movie-info">

                    <h3><%= movie.title %></h3>

                    <div class="buttons">

                        <button type="button" class="details-btn trailer-trigger" data-movie-id="<%= movie.id %>" data-movie-title="<%= movie.title %>">
                            <i class="fa-solid fa-play"></i>
                            Watch Trailer
                        </button>

                        <form action="/watchlist/add" method="POST">

                            <input type="hidden" name="movie_id" value="<%= movie.id %>">

                            <input type="hidden" name="movie_title" value="<%= movie.title %>">

                            <input type="hidden"
                                   name="poster"
                                   value="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>">

                            <button class="watch-btn">
                                <i class="fa-solid fa-bookmark"></i>
                                Watchlist
                            </button>

                        </form>

                    </div>

                </div>

            </div>

            <% }) %>

        </div>

        <button class="row-arrow right" aria-label="Scroll right"><i class="fa-solid fa-chevron-right"></i></button>

    </div>

</section>

<!-- ================= TOP RATED ================= -->

<section id="toprated" class="reveal">

    <h2 class="section-title">
        ⭐ Top Rated Movies
    </h2>

    <div class="row-wrapper">

